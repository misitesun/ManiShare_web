# Copy this file to .env.development after cloning or pulling the project.
# It is intentionally ignored because every developer may use a different local backend.

# Must match the development deployment target. The config rejects mismatches.
NEXT_PUBLIC_DEPLOY_ENV=development

# First-visit language for local development.
NEXT_PUBLIC_DEFAULT_LANGUAGE=zh-CN

# Optional local backend target for the Next dev /api proxy. Never commit real intranet addresses.
# API_PROXY_TARGET=http://localhost:8080

# Optional host for opening the dev server through a LAN address; use the host only, without scheme or port.
# Put your own value in .env.development.local instead of committing a changing machine IP.
# NEXT_DEV_ALLOWED_HOST=192.168.1.10
