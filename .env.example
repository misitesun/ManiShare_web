# Public values shared by all environments. This file documents the committed
# .env contract; do not copy it to .env.local because that would override every mode.
# Never add secrets to variables that start with NEXT_PUBLIC_: they are exposed in the browser bundle.

# Optional application name displayed in the product shell.
NEXT_PUBLIC_APP_NAME=English Learning

# Public metadata rendered into index.html. Internal systems remain non-indexable by default.
NEXT_PUBLIC_APP_DESCRIPTION=Responsive English learning web and desktop foundation
ROBOTS_POLICY=noindex,nofollow,noarchive

# Backend API prefix. Leave as /api when using the Next development proxy.
NEXT_PUBLIC_API_BASE_URL=/api

# Request timeout in milliseconds. Must be a positive integer.
NEXT_PUBLIC_API_TIMEOUT=15000

# NEXT_PUBLIC_DEPLOY_ENV and NEXT_PUBLIC_DEFAULT_LANGUAGE are mode-specific. Development uses
# the ignored .env.development created from .env.development.example.
